namespace ca.mcgill.ecse321.fashionstore.model;

class Account {
  abstract;

  lazy immutable email; // unique
  lazy password;
}

class Owner {
  isA Account;
}

class Customer {
  isA Account;

  lazy address;
  lazy Integer numLoyaltyPoints;

  * -> * ClothingItem shoppingCart;
  0..1 -- * Order purchasedOrders;      // an Order can have no Customer if the Customer's account was deleted
}

class Employee {
  isA Customer;

  0..1 -- * Order assignedOrders;
}

class Order {
  enum State { PURCHASED, ASSIGNED, PREPARED, DELIVERED, CANCELLED }

  lazy Integer id;
  lazy State state;
  lazy Date orderDate;
  lazy Date deliveryDate;
  lazy deliveryAddress;
  lazy Float price;

  * -> * ClothingItem items;
}

class ClothingProduct {
  lazy Integer id;
  lazy name;
  lazy Float price;
  lazy String image;           // image stored as String

  1 <@>- * ClothingItem items;
}

class ClothingItem {
  enum Size { XS, S, M, L, XL }
  enum Colour { RED, ORANGE, YELLOW, GREEN, BLUE, PURPLE, PINK, BLACK, GREY, WHITE, BROWN }

  lazy Integer id;
  lazy Size size;
  lazy Colour colour;
  lazy Integer numInStock;
}
