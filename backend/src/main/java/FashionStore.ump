namespace ca.mcgill.ecse321.fashionstore.model;

class Account {
  abstract;

  lazy immutable Integer id;
  lazy immutable email; // unique
  lazy password;
}

class Owner {
  isA Account;
}

class Customer {
  isA Account;

  lazy address;
  lazy Integer numLoyaltyPoints;

  0..1 <@>- * ShoppingCartItem shoppingCartItems;
  0..1 -- * Order purchasedOrders;      // an Order can have no Customer if the Customer's account was deleted
}

class Employee {
  isA Customer;

  0..1 -- * Order assignedOrders;       // an Order can have no Employee assigned to it.
}

class Order {
  enum State { PURCHASED, ASSIGNED, PREPARED, DELIVERED, CANCELLED }

  lazy immutable Integer id;
  lazy State state;
  lazy Date orderDate;
  lazy Date deliveryDate;
  lazy deliveryAddress;
  lazy Float price;

  0..1 <@>- * OrderItem items;
}

class OrderItem {
  lazy immutable Integer id;
  lazy Integer quantity;
  lazy Float purchasePrice;  // price of a single item at purchase

  * -> 0..1 ClothingItem;
}

class ShoppingCartItem {
  lazy immutable Integer id;
  lazy Integer quantity;

  * -> 0..1 ClothingItem;
}

class ClothingProduct {
  lazy immutable Integer id;
  lazy name;
  lazy Float price;
  lazy String image;          // image stored as String

  0..1 <@>- * ClothingItem items;
}

class ClothingItem {
  enum Size { XS, S, M, L, XL }
  enum Colour { RED, ORANGE, YELLOW, GREEN, BLUE, PURPLE, PINK, BLACK, GREY, WHITE, BROWN }

  lazy immutable Integer id;
  lazy Size size;
  lazy Colour colour;
  lazy Integer numInStock;
}
