namespace ca.mcgill.ecse321.fashionstore.model;

class FashionStore {
  1 <@>- 0..1 Owner;
  1 <@>- * Customer customers;
  1 <@>- * Order orders;
  1 <@>- * ClothingProduct products;
}

class Account {
  abstract;

  unique immutable email;
  password;
}

class Owner {
  isA Account;
}

class Customer {
  isA Account;

  address;
  Integer numLoyaltyPoints;

  * -> * ClothingItem shoppingCart;
  0..1 -- * Order purchasedOrders;      // an Order can have no Customer if the Customer's account was deleted
}

class Employee {
  isA Customer;

  0..1 -- * Order assignedOrders;
}

class Order {
  enum State { PURCHASED, ASSIGNED, PREPARED, DELIVERED, CANCELLED }

  autounique id;
  State state;
  Date orderDate;
  Date deliveryDate;
  deliveryAddress;
  Float price;

  * -> * ClothingItem items;
}

class ClothingProduct {
  autounique id;
  name;
  Float price;
  lazy image;           // image stored as String

  1 <@>- * ClothingItem items;
}

class ClothingItem {
  enum Size { XS, S, M, L, XL }
  enum Colour { RED, ORANGE, YELLOW, GREEN, BLUE, PURPLE, PINK, BLACK, GREY, WHITE, BROWN }

  autounique id;
  Size size;
  Colour colour;
  Integer numInStock;
}
